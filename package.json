{
  "name": "jichangyusuan-cc",
  "version": "1.0.0",
  "description": "机场预算 jichangyusuan.cc - 月付年付费用计算与套餐选择",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vitepress dev site",
    "content:plan": "tsx scripts/plan.ts",
    "content:prepare": "tsx scripts/prepare.ts",
    "check:structure": "tsx scripts/check-structure.ts",
    "check:content": "tsx scripts/check-content.ts",
    "check:links": "tsx scripts/check-links.ts",
    "check:secrets": "tsx scripts/check-secrets.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "build:site": "vitepress build site",
    "search:index": "pagefind --site site/dist",
    "build": "tsx scripts/build.ts",
    "preview": "vitepress preview site",
    "check:all": "pnpm typecheck && pnpm test && pnpm check:structure && pnpm check:content && pnpm check:links && pnpm check:secrets"
  },
  "dependencies": {
    "vue": "^3.5.13"
  },
  "devDependencies": {
    "@types/node": "^22.10.1",
    "pagefind": "^1.3.0",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "vitepress": "^1.6.3",
    "vitest": "^2.1.8"
  }
}
