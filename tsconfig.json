{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "jsx": "preserve",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "esModuleInterop": true,
    "lib": ["ESNext", "DOM"],
    "skipLibCheck": true,
    "noEmit": true,
    "baseUrl": ".",
    "paths": {
      "@/*": ["./*"],
      "@lib/*": ["./lib/*"],
      "@data/*": ["./data/*"]
    }
  },
  "include": [
    "scripts/**/*",
    "lib/**/*",
    "tests/**/*",
    "site/**/*",
    "data/**/*"
  ],
  "exclude": [
    "node_modules",
    "site/dist",
    "site/generated"
  ]
}
